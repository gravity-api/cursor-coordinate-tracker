<Window x:Class="CursorCoordinateTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="ToolWindow"
        Title="Cursor Coordinate Tracker v1.0"
        Height="230"
        Width="350">
    <Grid>
        <Label Content="Cursor Coordinate Tracker v1.0"
               HorizontalAlignment="Center"
               Margin="0,10,0,0"
               VerticalAlignment="Top"
               Height="40"
               Width="330"
               FontSize="22"
               FontWeight="Bold"/>

        <Label Content="X Pos:"
               HorizontalAlignment="Left"
               Margin="12,51,0,0"
               VerticalAlignment="Top"
               RenderTransformOrigin="-6.268,-0.931"/>

        <TextBox HorizontalAlignment="Left"
                 Margin="55,55,0,0"
                 TextWrapping="Wrap"
                 VerticalAlignment="Top"
                 Width="145"
                 Name="TxbAxisX"/>

        <Label Content="Y Pos:"
               HorizontalAlignment="Left"
               Margin="12,74,0,0"
               VerticalAlignment="Top"/>

        <TextBox HorizontalAlignment="Left"
                 Margin="55,78,0,0"
                 TextWrapping="Wrap"
                 VerticalAlignment="Top"
                 Width="145"
                 Name="TxbAxisY"/>

        <Button Content="▶ _Start"
                HorizontalAlignment="Left"
                Margin="55,101,0,0"
                VerticalAlignment="Top"
                RenderTransformOrigin="-0.57,1.481"
                Height="30"
                Width="70"
                Name="BtnStartStop"
                Click="BtnStartStop_Click"
                AccessKeyManager.AccessKeyPressed="BtnStartStop_AccessKeyPressed"
                Cursor="Hand"/>

        <Button Content="Set _Position"
                HorizontalAlignment="Left"
                Margin="130,101,0,0"
                VerticalAlignment="Top"
                Height="30"
                Width="70"
                Name="BtnSetPosition"
                Click="BtnSetPosition_Click"
                AccessKeyManager.AccessKeyPressed="BtnSetPosition_AccessKeyPressed"
                Cursor="Hand"/>


        <Viewbox HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Width="100"
                 Height="100"
                 Margin="211,52,0,0"
                 Stretch="Fill"
                 RenderTransformOrigin="0.5,0.5">

            <Canvas Width="640" Height="640">
                <Path Fill="Black"
                      Data="M173.3 66.5C181.4 62.4 191.2 63.3 198.4 68.8L518.4 308.7C526.7 314.9 530 325.7 526.8 335.5C523.6 345.3 514.4 351.9 504 351.9L351.7 351.9L440.6 529.6C448.5 545.4 442.1 564.6 426.3 572.5C410.5 580.4 391.3 574 383.4 558.2L294.5 380.5L203.2 502.3C197 510.6 186.2 513.9 176.4 510.7C166.6 507.5 160 498.3 160 488L160 88C160 78.9 165.1 70.6 173.3 66.5z">
                </Path>
            </Canvas>
        </Viewbox>

        <Label Content="Faster"
               HorizontalAlignment="Left"
               Margin="7,167,0,0"
               VerticalAlignment="Top"
               RenderTransformOrigin="0.405,-0.33"/>

        <Slider HorizontalAlignment="Left"
                Margin="48,171,0,0"
                VerticalAlignment="Top"
                Width="242"
                Minimum="500"
                Maximum="3000"
                Value="1000"
                Name="SldRefreshSpeed" ValueChanged="SldRefreshSpeed_ValueChanged"/>

        <Label Content="Slower"
               HorizontalAlignment="Left"
               Margin="288,167,0,0"
               VerticalAlignment="Top"
               RenderTransformOrigin="0.263,0.21"/>
    </Grid>
</Window>
